<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[P-101 pump seal-in]]>
</Comment>
<Text>
<![CDATA[[XIC(StartPB) ,XIC(RunCmd) ]XIO(StopPB)OTE(RunCmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Comment>
<![CDATA[LAH-101 at or above the setpoint]]>
</Comment>
<Text>
<![CDATA[GE(LevelPct,HiLevelSP)OTE(HiLevelAlm);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Comment>
<![CDATA[P-101 run timer]]>
</Comment>
<Text>
<![CDATA[XIC(RunCmd)TON(RunTmr,?,?);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Comment>
<![CDATA[P-101 start count]]>
</Comment>
<Text>
<![CDATA[XIC(RunCmd)CTU(Starts,?,?);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(StopPB)RES(Starts);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Comment>
<![CDATA[P-101 running when commanded with a speed]]>
</Comment>
<Text>
<![CDATA[XIC(RunCmd)GT(Pump1.Speed,0.0)GE(LevelLog[0],0.0)GE(SpareSP,0)OTE(Pump1.Run);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
<Program Name="Nautilus" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Description>
<![CDATA[nautilus side code: testing, verification and metrics. Generated; not part of the plant logic.]]>
</Description>
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[nautilus side code: one count per task scan — a live test waits on this to spend exactly N scans]]>
</Comment>
<Text>
<![CDATA[ADD(Nautilus_Scan,1,Nautilus_Scan);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
