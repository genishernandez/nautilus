<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Hand-built fixture: one controller alias tag of each kind a Logix
     export carries, every one named by a rung. An alias tag has no
     DataType in an export; its type is its AliasFor target's. -->
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="38.01" TargetName="AliasLine" TargetType="Controller" ContainsContext="false" ExportDate="(pinned)">
<Controller Name="AliasLine" ProcessorType="1756-L85E" MajorRev="38" MinorRev="11">
<DataTypes>
<DataType Name="PumpData" Family="NoFamily" Class="User">
<Members>
<Member Name="Speed" DataType="REAL" Dimension="0" Radix="Float" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="Starts" DataType="DINT" Dimension="0" Radix="Decimal" Hidden="false" ExternalAccess="Read/Write"/>
<Member Name="ZZZZZZZZZZPumpData2" DataType="SINT" Dimension="0" Radix="Decimal" Hidden="true" ExternalAccess="Read/Write"/>
<Member Name="Running" DataType="BIT" Dimension="0" Radix="Decimal" Hidden="false" Target="ZZZZZZZZZZPumpData2" BitNumber="0" ExternalAccess="Read/Write"/>
</Members>
</DataType>
</DataTypes>
<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="ValveCtl" Class="Standard" Revision="1.0" ExecutePrescan="false" ExecutePostscan="false" ExecuteEnableInFalse="false">
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Cmd" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="Open" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"/>
</Parameters>
<LocalTags/>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Cmd)OTE(Open);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
<Tag Name="Pump1Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Pump1" TagType="Base" DataType="PumpData" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Valve1Ctl" TagType="Base" DataType="ValveCtl" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="TankStatus" TagType="Base" DataType="DINT" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="TankLevels" TagType="Base" DataType="REAL" Dimensions="4" Radix="Float" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Run" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Alarm" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="Ready" TagType="Base" DataType="BOOL" Radix="Decimal" Constant="false" ExternalAccess="Read/Write"/>
<Tag Name="StartCmd" TagType="Alias" Radix="Decimal" AliasFor="Pump1Run" ExternalAccess="Read/Write">
<Description>
<![CDATA[Pump 1 start command]]>
</Description>
</Tag>
<Tag Name="Pump1Speed" TagType="Alias" Radix="Float" AliasFor="Pump1.Speed" ExternalAccess="Read/Write"/>
<Tag Name="Pump1Running" TagType="Alias" Radix="Decimal" AliasFor="Pump1.Running" ExternalAccess="Read/Write"/>
<Tag Name="Valve1Open" TagType="Alias" Radix="Decimal" AliasFor="Valve1Ctl.Open" ExternalAccess="Read/Write"/>
<Tag Name="TankLevelHi" TagType="Alias" Radix="Decimal" AliasFor="TankStatus.5" ExternalAccess="Read/Write"/>
<Tag Name="TankLevel" TagType="Alias" Radix="Float" AliasFor="TankLevels[2]" ExternalAccess="Read/Write"/>
<Tag Name="StartPB" TagType="Alias" Radix="Decimal" AliasFor="Local:1:I.Data.3" ExternalAccess="Read/Write"/>
</Tags>
<Programs>
<Program Name="Main" TestEdits="false" MainRoutineName="MainRoutine" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(StartPB)XIO(TankLevelHi)OTE(StartCmd);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(StartCmd)OTE(Run);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[GT(Pump1Speed,50.0)OTE(Alarm);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Pump1Running)XIC(Valve1Open)GT(TankLevel,2.5)OTE(Ready);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="MainTask" Type="PERIODIC" Rate="10" Priority="10" Watchdog="500">
<ScheduledPrograms>
<ScheduledProgram Name="Main"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
