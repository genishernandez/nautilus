<Routines>
<Routine Name="MainRoutine" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOVE(2000,Delays[0].PRE);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Pump1Run)TON(Delays[0],?,?)XIC(Delays[0].DN)OTE(Pump1Ready);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[MOVE(500,Delays[3].PRE);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(Valve1Open)TON(Delays[3],?,?)XIC(Delays[3].DN)OTE(Valve1Done);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[MOVE(1000,Delays[Sel].PRE);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(TankLevelHi)TON(Delays[Sel],?,?);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(Pump1Run)ONS(rt_r3_Pump1Run)CTU(Starts[1],?,?);]]>
</Text>
</Rung>
</RLLContent>
